# Server Configuration
PORT=3000

# AI Configuration
# Set to 'gemini' or 'openai'
AI_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# Default Company context for personalizing cold emails
SENDER_COMPANY_NAME=Zonava
SENDER_COMPANY_DESCRIPTION="Zonava is a premium digital agency specializing in MVP Development (4-8 weeks), Custom AI Solutions & Automation, High-Performance Web/SaaS Development (React, Next.js), Cross-Platform Mobile Apps (React Native/Flutter), Branding, and B2B Lead Generation."

# Default SMTP Configuration (For Gmail App Passwords)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your_email@gmail.com
# 16-character app password (not main password)
SMTP_PASS=xxxx_xxxx_xxxx_xxxx
SMTP_FROM_NAME="Your Name"

# Default IMAP Configuration (For Reading Replies)
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_SECURE=true
IMAP_USER=your_email@gmail.com
IMAP_PASS=xxxx_xxxx_xxxx_xxxx
